# Viteのブラウザ側で使用します。Publishable Keyは公開可能なキーです。
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# DB API用（Authと同じ公開設定をサーバー側でも使用します）
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# 現在の習慣APIはログインユーザーのJWTとRLSを使うため、Secret Keyは不要です。
# SUPABASE_SECRET_KEY=将来の管理処理専用。ブラウザへ公開しない。

# 旧キーを使う場合の代替名（上の新しいキー名を優先します。管理処理以外では不要です）
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
